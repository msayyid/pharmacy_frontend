# ============================================================================
# Nookat Storefront — example environment configuration
# ============================================================================
# Copy to .env.local for development:
#   cp .env.example .env.local
# Real production / staging values come from Coolify env (NOT this file).
# See docs/runbooks/deploy.md for the canonical per-env values.
#
# Two layers:
#   - NEXT_PUBLIC_*  — inlined at build time, exposed to the browser. Safe to
#                       leak; never put secrets here.
#   - server-only    — read in route handlers / server components / Sentry
#                       instrumentation. Validated by lib/env/server.ts on
#                       import (Zod fail-loud per Phase 3 D11).
#
# When you add a new env var:
#   1. Add it here with a comment explaining what it controls.
#   2. Add it to lib/env/{server,client}.ts Zod schema.
#   3. Add it to .github/workflows/ci.yml top-level env block (CI defaults).
#   4. Add it to scripts/build-ci.sh (local CI parity).
#   5. Add it to Dockerfile builder + runtime stages where build-time matters.
#   6. Document it in docs/runbooks/deploy.md per-environment table.
# ============================================================================


# --- Public env (exposed to the browser; safe) -------------------------------

# Backend API origin. Inlined into client bundles; the browser uses this for
# CORS / fetch / image loading. Match Coolify env per environment:
#   local      → http://localhost:8000
#   staging    → https://api.staging.nookat.kg
#   production → https://api.nookat.kg
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical site URL. Used by sitemap.xml, robots.txt, JSON-LD, OG meta,
# canonical alternates. Without this, falls back to the API URL's origin
# (good enough for dev; required for staging + production).
#   staging    → https://staging.nookat.kg
#   production → https://nookat.kg
# NEXT_PUBLIC_SITE_URL=

# Default locale for the negotiator. URL-prefix wins on first hit; this is
# the cookie-less fallback.
NEXT_PUBLIC_DEFAULT_LOCALE=ru

# Environment label. Surfaces in Sentry events as `environment`. Values:
# development | test | staging | production
NEXT_PUBLIC_ENV=development

# Sentry browser DSN. Without it, Sentry SDK is a runtime no-op (the
# DSN-optional contract from Phase 11D). Real DSN injected by Coolify.
# NEXT_PUBLIC_SENTRY_DSN=

# Sentry release identifier override. Defaults to
# nookat-storefront@<package_version>. Coolify can override with the
# git SHA of the deploy.
# NEXT_PUBLIC_SENTRY_RELEASE=


# --- Server-only env (NOT exposed to the browser) ----------------------------

# Backend API origin used by RSC fetchers, route handlers, instrumentation.
# Match NEXT_PUBLIC_API_URL above per environment. Server-side reads do NOT
# go through the browser bundle, so a separate var protects against
# accidental client-side leaks if the public version is ever wrong.
API_URL=http://localhost:8000

# Sentry server DSN. Same DSN as NEXT_PUBLIC_SENTRY_DSN at MVP — Sentry
# uses one project for both client and server runtimes. Real DSN injected
# by Coolify.
# SENTRY_DSN=

# Sentry release override (server-side equivalent of NEXT_PUBLIC_SENTRY_RELEASE).
# SENTRY_RELEASE=

# Sentry source-map upload token. Required at build time only when DSN is
# set so source maps land in Sentry. Coolify env-injects this for the
# Docker build.
# SENTRY_AUTH_TOKEN=

# Node environment. Should be `production` in any deployed env (Coolify
# Dockerfile sets this in the runtime stage); `development` for local
# dev; `test` for CI / vitest.
NODE_ENV=development


# --- Build-time only (Coolify / CI; not in .env.local) ----------------------

# Bundle analyzer. Set to `true` to emit .next/analyze/{client,server,edge}.html.
# pnpm analyze sets this for you.
# ANALYZE=
